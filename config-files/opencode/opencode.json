{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "small_model": "deepseek/deepseek-v4-flash",
  "mcp": {
    "semble": {
      "type": "local",
      "command": [
        "/home/travis/.local/bin/semble-opencode-safe"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "provider": {
    "gpt-pro-sub2api": {
      "npm": "@ai-sdk/openai",
      "name": "gpt-pro-sub2api",
      "options": {
        "baseURL": "https://your-local-mirror.example.com/v1",
        "apiKey": "sk-your-local-mirror-api-key-here"
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT-5.2",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        },
