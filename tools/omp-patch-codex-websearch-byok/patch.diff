+async function readYamlConfig<T>(filePath: string): Promise<T | null> {
+	try {
+		const raw = await Bun.file(filePath).text();
+		const parsed = YAML.parse(raw);
+		if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+			return null;
+		}
+
+		return parsed as T;
+	} catch (error) {
+		if (isEnoent(error)) return null;
+		throw error;
+	}
+}
+
+async function getRequestedByokModel(): Promise<RequestedModel | null> {
+	const requestedByEnv = resolveRequestedModel($env.PI_CODEX_WEB_SEARCH_MODEL);
+	if (requestedByEnv) return requestedByEnv;
+
+	const configPath = path.join(getAgentDir(), "config.yml");
+	const config = await readYamlConfig<AgentConfig>(configPath);
+	return resolveRequestedModel(config?.modelRoles?.default);
+}
+
+function selectConfiguredModel(
+	providerName: string,
+	providerConfig: ModelsConfigProvider,
+	requestedModel: RequestedModel | null,
+): string | null {
+	const availableModels =
+		providerConfig.models?.flatMap(model => {
+			const modelId = model.id?.trim();
+			return modelId ? [modelId] : [];
+		}) ?? [];
+
+	if (availableModels.length === 0) return null;
+	if (!requestedModel) return availableModels[0] ?? null;
+	if (requestedModel.provider && requestedModel.provider !== providerName) return null;
+
+	return availableModels.find(modelId => modelId === requestedModel.modelId) ?? null;
+}
+
+async function loadBYOKConfig(): Promise<BYOKConfig | null> {
+	const requestedModel = await getRequestedByokModel();
