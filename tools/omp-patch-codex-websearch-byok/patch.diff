+function selectConfiguredModel(
+	providerName: string,
+	providerConfig: ModelsConfigProvider,
+	requestedModel: RequestedModel | null,
+): string | null {
+	const availableModels =
+		providerConfig.models?.flatMap(model => {
+			const modelId = model.id?.trim();
+			return modelId ? [modelId] : [];
+		}) ?? [];
+
+	if (availableModels.length === 0) return null;
+	if (!requestedModel) return availableModels[0] ?? null;
+	if (requestedModel.provider && requestedModel.provider !== providerName) return null;
+
+	const exactModel = availableModels.find(modelId => modelId === requestedModel.modelId);
+	if (exactModel) return exactModel;
+
+	const modelWithoutThinkingSuffix = stripConfiguredThinkingSuffix(requestedModel.modelId);
+	if (modelWithoutThinkingSuffix === requestedModel.modelId) return null;
+
+	return availableModels.find(modelId => modelId === modelWithoutThinkingSuffix) ?? null;
